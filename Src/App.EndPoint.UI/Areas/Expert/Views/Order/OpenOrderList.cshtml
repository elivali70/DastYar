@model List<OpenOrderOutPutViewModel>
@{
    ViewData["Title"] = "لیست سفارشات";
    int row = 1;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>لیست سفارشات</h2>
</div>
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">لیست سفارشات</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th scope="col">ردیف</th>
                        <th scope="col">شناسه سفارش</th>
                        <th scope="col">نام سرویس</th>
                        <th scope="col">نام کابری متخصص </th>
                        <th scope="col">نام کاربری مشتری</th>
                        <th scope="col">نام خانوادگی مشتری</th>
                        <th scope="col">شماره تماس مشتری</th>
                        <th scope="col"> آدرس مشتری</th>
                        <th scope="col">قیمت پایه</th>
                        <th scope="col">تاریخ ایجاد</th>
                        <th scope="col">توضیحات</th>
                        <th scope="col">وصعیت سفارش  </th>
                        <th scope="col">زمان ترجیحی انجام کار</th>
                        <th scope="col">عملیات</th>
                    </tr>
                </thead>
                <tfoot>
                    <tr>
                        <th scope="col">ردیف</th>
                        <th scope="col">شناسه سفارش</th>
                        <th scope="col">نام سرویس</th>
                        <th scope="col">نام کابری متخصص </th>
                        <th scope="col">نام کاربری مشتری</th>
                        <th scope="col">نام خانوادگی مشتری</th>
                        <th scope="col">شماره تماس مشتری</th>
                        <th scope="col"> آدرس مشتری</th>
                        <th scope="col">قیمت پایه</th>
                        <th scope="col">تاریخ ایجاد</th>
                        <th scope="col">توضیحات</th>
                        <th scope="col">وصعیت سفارش  </th>
                        <th scope="col">زمان ترجیحی انجام کار</th>
                        <th scope="col">عملیات</th>
                    </tr>
                </tfoot>
                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@row</td>
                            <td>@item.OrderId</td>
                            <td> @item.ServiceName </td>
                            <td>  @item.ExpertUserName </td>
                            <td>@item.CustomerUserName</td>
                            <td>  @item.CustomerLastName </td>
                            <td>@item.CustomerPhoneNumber</td>
                            <td>@item.CustomerAddress</td>
                            <td>@item.BasePrice</td>
                            <td>@item.CreatedAt</td>
                            <td>@item.Discription</td>
                            <td>@item.OrderStatus</td>
                            <td>@item.PrefferedDateTime</td>
                            <td>
                                <form asp-area="Expert" asp-controller="Order" asp-action="ChooseOrder" asp-route-id="@item.OrderId" method="get" > 
                                    <button type="submit" class=" btn btn-primary" onsubmit="return confirm('آیا از انتخاب این سفارش مطمئن هستید؟');">انتخاب</button>
                                </form>
                            </td>
                        </tr>
                        row++;
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>
