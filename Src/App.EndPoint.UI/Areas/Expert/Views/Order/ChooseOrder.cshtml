@model SuggestedPriceViewModel
<h2 class="mb-3 text-center text-bg-success p-3 ">
   پیشنهاد قیمت
</h2>
<form asp-area="Expert" asp-controller="Order" asp-action="ChooseOrder" method="post">

    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label class="form-label" asp-for="ExpertId">   </label>
        <input type="number" class="form-control" asp-for="ExpertId" readonly="readonly"/>
        <span asp-validation-for="ExpertId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="OrderId">  </label>
        <input type="number" class="form-control" asp-for="OrderId" />
        <span asp-validation-for="OrderId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="SuggestedPrice">  </label>
        <input type="number" class="form-control" asp-for="SuggestedPrice" />
        <span asp-validation-for="SuggestedPrice" class="text-danger"></span>
    </div>

    
    <div class="mb-3">
        <button type="submit" class="btn btn-success"> ذخیره</button>
        <a class="btn btn-primary " asp-area="Expert" asp-controller="Order" asp-action="OpenOrderList"><i class="fas fa-arrow-right"></i>بازگشت</a>
    </div>
</form>