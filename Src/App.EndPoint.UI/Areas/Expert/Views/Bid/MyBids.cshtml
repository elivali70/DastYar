@model List<BidsOutPutViewModel>
@{
    ViewData["Title"] = "لیست پیشنهادات";
    int row = 1;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>لیست پیشنهادات</h2>
</div>
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">لیست پیشنهادات</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th scope="col">ردیف</th>
                        <th scope="col">شناسه پیشنهاد</th>
                        <th scope="col">شناسه سفارش</th>
                        <th scope="col">شناسه متخصص</th>
                        <th scope="col">قیمت پیشنهادی</th>
                        <th scope="col">وضعیت سفارش  </th>
                        <th scope="col">تاریخ ایجاد</th>
                        <th scope="col">عملیات</th>
                    </tr>
                </thead>
                <tfoot>
                    <tr>
                        <th scope="col">ردیف</th>
                        <th scope="col">شناسه پیشنهاد</th>
                        <th scope="col">شناسه سفارش</th>
                        <th scope="col">شناسه متخصص</th>
                        <th scope="col">قیمت پیشنهادی</th>
                        <th scope="col">وضعیت سفارش  </th>
                        <th scope="col">تاریخ ایجاد</th>
                        <th scope="col">عملیات</th>
                    </tr>
                </tfoot>
                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@row</td>
                            <td>  @item.Id </td>
                            <td>@item.OrderId</td>
                            <td> @item.ExpertId </td>
                            <td>@item.SuggestedPrice</td>
                            <td>  @item.ProposalStatus </td>
                            <td>@item.CreatedAt</td>
                            <td>
                                <a class="btn btn-primary" asp-area="Expert" asp-controller="Home" asp-action="Index">بازگشت</a>
                                <form asp-area="Expert" asp-controller="Bid" asp-action="DeleteBid" method="post">
                                    <button type="submit" class=" btn btn-danger" onsubmit="return confirm('آیا از حذف این پیشنهاد مطمئن هستید؟');">حذف</button>
                                </form>
                                <form asp-area="Expert" asp-controller="Bid" asp-action="Comment" method="get">
                                    <button type="submit" class=" btn btn-primary">ثبت دیدگاه</button>
                                </form>
                            </td>
                        </tr>
                        row++;
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>
