@model List<OrderProposalOutPutViewModel>
@{
    ViewData["Title"] = "لیست وضعیت پیشنهادات";
    int row = 1;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>لیست وضعیت پیشنهادات</h2>

   
</div>

<div class="input-group">
    <form class="d-none d-sm-inline-block form-inline mr-auto ml-md-3 my-2 my-md-0 mw-100 navbar-search" id="searchForm"
          asp-area="Admin" asp-controller="OrderProposal" asp-action="Search" method="get">
        <div class="input-group">
            <input type="text" class="form-control bg-light border-0 small" id="searchKeyword" name="keyWord" placeholder="شناسه سفارش سفارش را وارد کنید...."
                   aria-label="Search" aria-describedby="basic-addon2">
            <div class="input-group-append">
                <button class="btn btn-primary" type="submit">
                    <i class="fas fa-search fa-sm"> جستجو</i>
                </button>
            </div>
        </div>
    </form>
</div>
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">لیست وضعیت پیشنهادات</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th scope="col">ردیف</th>
                        <th scope="col">شناسه پیشنهاد</th>
                        <th scope="col">شناسه سفارش</th>
                        <th scope="col">نام کاربری متخصص</th>
                        <th scope="col">قیمت پیشنهادی</th>
                        <th scope="col">تاریخ ایجاد</th>
                        <th scope="col">وضعیت</th>
                        <th scope="col">تاریخ انجام کار</th>
                        <th scope="col">مدت زمان انجام کار</th>
                        <th scope="col">توضیحات</th>
                    </tr>
                </thead>
               
                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@row</td>
                            <td>@item.Id</td>
                            <td>@item.OrderId
                                <a asp-area="Admin" asp-controller="Order" asp-action="Detail" asp-route-id="@item.OrderId" class="btn  btn-danger "> مشاهده </a>
                            </td>
                            <td>@item.ExpertUserName </td>
                            <td>@item.SuggestedPrice</td>
                            <td>@item.CreatedAt </td>
                            <td>@item.ProposalStatus</td>
                            <td>@item.StatrtedDateTime</td>
                            <td>@item.DurationTime</td>
                            <td>@item.Discription</td>
                        </tr>
                        row++;
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>
<div class="modal fade" id="validationModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">خطای اعتبارسنجی</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                لطفاً عبارت موردنظر برای جستجو را وارد کنید.
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    متوجه شدم
                </button>
            </div>

        </div>
    </div>
</div>
<script>

const form = document.getElementById("searchForm");
const keyword = document.getElementById("searchKeyword");

form.addEventListener("submit", function (event) {

    if (keyword.value.trim() === "") {
        event.preventDefault();

        const modal = new bootstrap.Modal(
            document.getElementById("validationModal")
        );

        modal.show();
    }
});
</script>