@model List<CommentViewModel>
@{
    ViewData["Title"] = "لیست نظرات";
    int row = 1;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>لیست نظرات</h2>

   
</div>
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">لیست نظرات</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th scope="col">ردیف</th>
                        <th scope="col">شناسه پیشنهاد</th>
                        <th scope="col">شناسه سفارش</th>
                        <th scope="col">تاریخ ایجاد</th>
                        <th scope="col">توضیحات</th>
                        <th scope="col">شناسه کاربر</th>
                        <th scope="col">عملیات</th>
                    
                    </tr>
                </thead>
               
                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@row</td>
                            <td>@item.Id</td>
                            <td>@item.OrderId</td>
                            <td>@item.CreatedAt </td>
                            <td>@item.Discription</td>
                            <td>@item.UserId </td>
                            <td>
                                <form asp-area="Admin" asp-controller="Comment" asp-action="Delete"
                                      asp-route-id="@item.Id" method="post" onsubmit="return confirm('آیا از حذف این نظر مطمئن هستید؟');">
                                    <button type="submit" class=" btn btn-danger" >حذف</button>
                                </form>
                                </td>
                           
                        </tr>
                        row++;
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>
