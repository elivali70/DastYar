@model List<BidViewModel>
@{
    ViewData["Title"] = "لیست پیشنهادها";
    int row = 1;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>لیست پیشنهادها</h2>
</div>
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">لیست پیشنهادها</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th scope="col">ردیف</th>
                        <th scope="col">شناسه </th>
                        <th scope="col">شناسه سفارش</th>
                        <th scope="col">شناسه متخصص</th>
                        <th scope="col">شماره تماس متخصص</th>
                        <th scope="col">نام کاربری متخصص</th>
                        <th scope="col">قیمت پیشنهادی</th>
                        <th scope="col">تاریخ ایجاد</th>
                        <th scope="col">عملیات</th>
                    </tr>
                </thead>
                <tfoot>
                    <tr>
                        <th scope="col">ردیف</th>
                        <th scope="col">شناسه </th>
                        <th scope="col">شناسه سفارش</th>
                        <th scope="col">شناسه متخصص</th>
                        <th scope="col">شماره تماس متخصص</th>
                        <th scope="col">نام کاربری متخصص</th>
                        <th scope="col">قیمت پیشنهادی</th>
                        <th scope="col">تاریخ ایجاد</th>
                        <th scope="col">عملیات</th>
                    </tr>
                </tfoot>
                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@row</td>
                            <td>@item.Id</td>
                            <td> @item.OrderId </td>
                            <td> @item.ExpertId </td>
                            <td> @item.ExpertPhoneNumber </td>
                            <td> @item.ExpertUserName </td>
                            <td> @item.ProposalStatus </td>
                            <td>@item.SuggestedPrice</td>
                            <td>@item.CreatedAt</td>
                            <form asp-area="Customer" asp-controller="Order" asp-action="SelectBid" asp-route-id="@item.Id"  method="post">

                                <input type="hidden" name="bidId" value="@item.Id" />

                                <button type="submit" class="btn btn-success"> انتخاب متخصص </button>
                            </form>
                        </tr>
                        row++;
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>
