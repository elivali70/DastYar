@model UpdateProfileViewModel
<h2 class="mb-3 text-center text-bg-success p-3 ">
    ویرایش  کاربر @Model.UserName
</h2>
<form asp-area="Customer" asp-controller="Home" asp-action="UpdateProfile" asp-route-id="@Model.UserId" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="UserId" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label class="form-label" asp-for="UserName">  </label>
        <input type="text" class="form-control" asp-for="UserName" />
        <span asp-validation-for="UserName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Name">  </label>
        <input type="text" class="form-control" asp-for="Name" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="LastName">  </label>
        <input type="text" class="form-control" asp-for="LastName" />
        <span asp-validation-for="UserName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Email">  </label>
        <input type="email" class="form-control" asp-for="Email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="PhoneNumber">  </label>
        <input type="tel" class="form-control" asp-for="PhoneNumber" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Address">  </label>
        <input type="text" class="form-control" asp-for="Address" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="File">تصاویر و فیلم محصول</label>
        <input type="file" class="form-control" asp-for="File" accept="image/*" />
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="File">نام فایل</label>
        <input type="file" class="form-control" asp-for="File" accept="image/*" />
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="DiscriptionFile">توضیحات مربوط به عکس</label>
        <input type="text" class="form-control" asp-for="DiscriptionFile" />
    </div>
    <div class="mb-3">
        <button type="submit" class="btn btn-success"> ذخیره</button>
        <a class="btn btn-primary " asp-area="Customer" asp-controller="Home" asp-action="Index"><i class="fas fa-arrow-right"></i>بازگشت</a>
    </div>
</form>