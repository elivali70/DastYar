@using Microsoft.Identity.Client.NativeInterop
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <title>@ViewData["Title"] - دستیار</title>

    <link href="~/AdminAreasFile/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">

    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,700,800,900"
          rel="stylesheet">

    <link href="~/AdminAreasFile/css/sb-admin-2.min.css" rel="stylesheet">
    <link href="~/AdminAreasFile/css/custome.css" rel="stylesheet" />
</head>

<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- Sidebar -->
        <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">

            <!-- Sidebar - Brand -->
            <a class="sidebar-brand d-flex align-items-center justify-content-center" href="index.html">
                <div class="sidebar-brand-icon rotate-n-15">
                    <i class="fas fa-laugh-wink"></i>
                </div>
                <div class="sidebar-brand-text mx-3">پروفایل مشتری </div>
            </a>

            <!-- Divider -->
            <hr class="sidebar-divider my-0">

            <!-- Nav Item - Dashboard -->
            <li class="nav-item active">
                <a class="nav-link" href="index.html">
                    <i class="fas fa-fw fa-tachometer-alt"></i>
                    <span>داشبورد</span>
                </a>
            </li>

            <!-- Divider -->
            <hr class="sidebar-divider">

            <div class="sidebar-heading">
                تنظیمات شخصی
            </div>

            <!-- Nav Item - Pages Collapse Menu -->
            <li class="nav-item">
                <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseTwo"
                   aria-expanded="true" aria-controls="collapseTwo">
                    <i class="fas fa-fw fa-cog"></i>
                    <span>پروفایل</span>
                </a>
                <div id="collapseTwo" class="collapse" aria-labelledby="headingTwo" data-parent="#accordionSidebar">
                    <div class="bg-white py-2 collapse-inner rounded">
                        <h6 class="collapse-header">منوی پروفایل</h6>
                        <a class="collapse-item" asp-area="Customer" asp-controller="Home" asp-action="UpdateProfile">ویرایش پروفایل</a>
                        <a class="collapse-item" asp-area="Customer" asp-controller="Home" asp-action="ChangPassword">رمز عبور</a>
                    </div>
                </div>
            </li>
            <hr class="sidebar-divider">

            <div class="sidebar-heading">
                مدیریت سفارش ها
            </div>
           
            <li class="nav-item">
                <a class="nav-link" class="collapse-item" asp-area="Customer" asp-controller="Order" asp-action="Create">
                    <i class="fas fa-fw fa-trademark"></i>
                    <span> ثبت سفارش </span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" class="collapse-item" asp-area="Customer" asp-controller="Order" asp-action="AcceptedOrders">
                    <i class="fas fa-fw fa-trademark"></i>
                    <span>  مشاهده سفارش های قیلی </span>
                </a>
            </li>
           
        </ul>
        <!-- End of Sidebar -->
        <!-- Content Wrapper -->
        <div id="content-wrapper" class="d-flex flex-column">
            <!-- Main Content -->
            <div id="content">
                <!-- Topbar -->
                <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">
                    <!-- Sidebar Toggle (Topbar) -->
                    <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                        <i class="fa fa-bars"></i>
                    </button>
                    <!-- Topbar Navbar -->
                    <ul class="navbar-nav ml-auto">
                        <div class="topbar-divider d-none d-sm-block"></div>
                        <!-- Nav Item - User Information -->
                        <li class="nav-item dropdown no-arrow">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button"
                               data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <span class="mr-2 d-none d-lg-inline text-gray-600 small">@User.Identity.Name  </span>
                                <img class="img-profile rounded-circle" src="img/eliprofile.jpg">
                            </a>
                            <!-- Dropdown - User Information -->
                            <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in"
                                 aria-labelledby="userDropdown">
                                <a class="dropdown-item" asp-area="Customer" asp-controller="Home" asp-action="ChangePassword">
                                    <i class="fas fa-user fa-sm fa-fw mr-2 text-gray-400"></i>
                                    تغییر رمز عیور
                                </a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" asp-controller="Account" asp-action="Logout" data-toggle="modal" data-target="#logoutModal">
                                    <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-gray-400"></i>
                                    خروج
                                </a>
                            </div>
                        </li>

                    </ul>

                </nav>
                <!-- End of Topbar -->
                @RenderBody();

            </div>
            <!-- End of Main Content -->
            <!-- Footer -->
            <footer class="sticky-footer bg-white">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <h6> دستیار</h6>
                    </div>
                </div>
            </footer>
            <!-- End of Footer -->

        </div>
        <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->
    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>
    <!-- Logout Modal-->
    <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
         aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Ready to Leave?</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">جهت اطمینان از خروج حساب کاربری کلیک کنید</div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">لغو</button>
                    <a class="btn btn-primary" asp-controller="Account" asp-action="Logout">خروج</a>
                </div>
            </div>
        </div>
    </div>

    <script src="~/AdminAreasFile/jquery/jquery.factory.js"></script>
    <script src="~/AdminAreasFile/lib/jquery/jquery.factory.min.js"></script>
    <script src="~/AdminAreasFile/lib/jquery/jquery.factory.slim.js"></script>
    <script src="~/AdminAreasFile/lib/jquery/jquery.factory.slim.min.js"></script>
    <script src="~/AdminAreasFile/lib/jquery/jquery.js"></script>
    <script src="~/AdminAreasFile/lib/jquery/jquery.min.js"></script>
    <script src="~/AdminAreasFile/ib/jquery/jquery.slim.js"></script>
    <script src="~/AdminAreasFile/lib/jquery/jquery.slim.min.js"></script>
    <script src="~/AdminAreasFile/vendor/jquery/jquery.min.js"></script>
    <script src="~/AdminAreasFile/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Core plugin JavaScript-->
    <script src="~/AdminAreasFile/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="~/AdminAreasFile/js/sb-admin-2.min.js"></script>

    <!-- Page level plugins -->
    <script src="~/AdminAreasFile/vendor/chart.js/Chart.min.js"></script>

    <!-- Page level custom scripts -->
    <script src="~/AdminAreasFile/js/demo/chart-area-demo.js"></script>
    <script src="~/AdminAreasFile/js/demo/chart-pie-demo.js"></script>
    <script src="~/AdminAreasFile/lib/jquery-validate/additional-methods.js"></script>
    <script src="~/AdminAreasFile/lib/jquery-validate/additional-methods.min.js"></script>
    <script src="~/AdminAreasFile/lib/jquery-validate/jquery.validate.js"></script>
    <script src="~/AdminAreasFile/lib/jquery-validate/jquery.validate.min.js"></script>
    <script src="~/AdminAreasFile/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
    <script src="~/AdminAreasFile/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
<script>
    $(document).ready(function(){
        $("input.input-validation-error").addClass("is-invalid");
        $("span.field-validation-error").addClass("text-danger");
    });
</script>
</html>
